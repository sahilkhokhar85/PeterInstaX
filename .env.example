BOT_TOKEN=123456:ABC...
OWNER_ID=123456789

IG_USERNAME=your_secondary_instagram_username
IG_PASSWORD=your_secondary_instagram_password
# optional: 2FA authenticator secret (base32), auto-generates login codes
IG_TOTP_SECRET=
# optional: browser "sessionid" cookie - only used by `python bot.py --login`
# (run locally, never on the VPS). Leave blank once you have a session.json.
IG_SESSIONID=
# optional: http://user:pass@host:port (residential/static proxy recommended on VPS)
IG_PROXY=

# ---- safety / pacing (see bot.py module docstring for the reasoning) ----
# target seconds to cycle through ALL non-priority accounts once (delay ~= this)
FULL_SCAN_SECONDS=300
# priority accounts (/priority) are checked this often
PRIO_SECONDS=90
# random gap between accounts within a round, seconds
SCAN_GAP_MIN=3
SCAN_GAP_MAX=7
# check an account's stories every Nth round (posts are checked every round)
STORY_EVERY=3
# optional daily rest window, "HH:MM-HH:MM" in IST (QUIET_TZ_OFFSET_MIN) - polling
# pauses during this window. Leave blank to disable.
QUIET_HOURS=
QUIET_TZ_OFFSET_MIN=330

# fast path (home feed + stories tray, 2 calls for ~all accounts) - OFF by default.
# This killed the Instagram session twice before on a datacenter IP. Only turn on
# after testing carefully on a throwaway account.
FAST_PATH=0
FEED_SECONDS=60

COVER_FRAME=1

# ---- file paths (defaults are fine for a single-bot VPS; change only if you run
#      more than one instance in the same directory) ----
IG_SESSION_FILE=session.json
IG_DATA_STORE=data.json

# ---- remote control from mhajk_.py (see README "Remote control" section) ----
# Shared JSON files both bots can see (same VPS / same directory, or synced).
IG_CMD_FILE=ig_commands.json
IG_DATA_FILE=ig_data.json
IG_CMD_POLL_SECONDS=5
